# Copy this file to .env (git-ignored) and fill in your values; the agent, app and batch load it on startup.
# A variable already set in your shell wins over .env. Tests never read .env and never call a real LLM.
# Never commit keys: this repo is public.

# LLM (agent/llm.py). Leave LLM_PROVIDER empty to run fully offline with rules and templates.
# Pick one provider: anthropic, openai, openrouter or deepseek.
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# OpenAI (set LLM_PROVIDER=openai; LLM_MODEL is required, e.g. the OpenAI model your team has access to)
OPENAI_API_KEY=
# LLM_MODEL=
# OPENAI_REASONING_EFFORT=low     # only for OpenAI reasoning models; leave unset otherwise

# OpenRouter: open-weight models (set LLM_PROVIDER=openrouter; LLM_MODEL is required, e.g. google/gemma-4-26b-a4b-it)
# OPENROUTER_API_KEY=
# OPENROUTER_REASONING=off        # off for models with a thinking switch (Gemma 4, Qwen); low for gpt-oss (can't turn off)
# OPENROUTER_DATA_COLLECTION=deny # default: only hosts that keep no complaint text
# OPENROUTER_SORT=throughput      # pick the fastest host instead of the cheapest (live round)
# OPENROUTER_IGNORE=darkbloom     # hosts to skip, comma-separated: Darkbloom drops required JSON fields (Gemma 4)

# DeepSeek's own platform (platform.deepseek.com). LLM_MODEL defaults to deepseek-flash (DeepSeek-V4.1-Flash).
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_REASONING_EFFORT=none  # default: thinking off; low | high | max turn it on

# Reliability and cost limits (defaults shown)
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=2               # SDK retries for rate limits, 5xx and timeouts
# LLM_MAX_CALLS_PER_COMPLAINT=6
# LLM_MAX_TOKENS_PER_COMPLAINT=40000

# Batch runs (scripts/run_batch.py)
TEAM_NAME=our-team
BATCH_WORKERS=8

# App (app/store.py)
# CASE_DB=runtime/cases.db

# Access control (app/UserAccessControl). Without AUTH_SECRET a random key is generated into runtime/auth_secret.
# AUTH_SECRET=
# AUTH_TOKEN_HOURS=8
# STAFF_CSV=data/staff.csv
# CUSTOMERS_CSV=data/customers.csv                    read only: who may sign up
# CUSTOMER_ACCOUNTS_CSV=data/customer_accounts.csv    customer sign-ups (git-ignored)

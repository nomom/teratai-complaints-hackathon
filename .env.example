# Set these in your shell (nothing loads a .env file automatically). Never commit keys: this repo is public.

# LLM (agent/llm.py). Leave LLM_PROVIDER empty to run fully offline with rules and templates.
# Pick one provider: anthropic or openai.
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# OpenAI (set LLM_PROVIDER=openai; LLM_MODEL is required, e.g. the OpenAI model your team has access to)
OPENAI_API_KEY=
# LLM_MODEL=
# OPENAI_REASONING_EFFORT=low     # only for OpenAI reasoning models; leave unset otherwise

# Reliability and cost limits (defaults shown)
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=2               # SDK retries for rate limits, 5xx and timeouts
# LLM_MAX_CALLS_PER_COMPLAINT=6
# LLM_MAX_TOKENS_PER_COMPLAINT=40000

# Batch runs (scripts/run_batch.py)
TEAM_NAME=our-team
BATCH_WORKERS=8

# App (app/store.py)
# CASE_DB=runtime/cases.db

# Access control (app/UserAccessControl). Without AUTH_SECRET a random key is generated into runtime/auth_secret.
# AUTH_SECRET=
# AUTH_TOKEN_HOURS=8
# STAFF_CSV=data/staff.csv
# CUSTOMERS_CSV=data/customers.csv

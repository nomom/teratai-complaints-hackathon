# Set these in your shell (nothing loads a .env file automatically). Never commit keys: this repo is public.

# LLM (agent/llm.py). Leave LLM_PROVIDER empty to run fully offline with rules and templates.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# Batch runs (scripts/run_batch.py)
TEAM_NAME=our-team
BATCH_WORKERS=8

# App (app/store.py)
# CASE_DB=runtime/cases.db
